---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import AboutHero from "@/components/AboutHero.astro";
import AboutProfile from "@/components/AboutProfile.astro";
import AboutFacts from "@/components/AboutFacts.astro";
import AboutQuote from "@/components/AboutQuote.astro";
import { about } from "@/config/about";
---

<BaseLayout title={about.heading} description={about.intro}>
  <SiteHeader />
  <main id="content" class="main-wrapper">
    {about.showHero && <AboutHero />}
    {about.showProfile && <AboutProfile />}
    {about.showFacts && <AboutFacts />}
    {about.quote.enabled && <AboutQuote />}
  </main>
  <SiteFooter />
</BaseLayout>
