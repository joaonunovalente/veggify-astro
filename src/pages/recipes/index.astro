---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import RecipeCard from "@/components/RecipeCard.astro";
import CategoryList from "@/components/CategoryList.astro";
import Pagination from "@/components/Pagination.astro";
import { PAGE_SIZE, getListedRecipes } from "@/lib/recipes";

/** Page size matches the legacy template: 9 recipes on page 1. */

const listed = getListedRecipes(await getCollection("recipes"));
const pageRecipes = listed.slice(0, PAGE_SIZE);
const hasNext = listed.length > PAGE_SIZE;
---

<BaseLayout title="All recipes" description="Browse all Veggify recipes.">
  <SiteHeader />
  <main id="content" class="main-wrapper">
    <section class="section">
      <div class="container">
        <div class="_12-columns fade-up">
          <div class="column desktop-6 tablet-12">
            <div class="text-center">
              <h1 class="heading xxl">All recipes</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section double-bottom no-top-padding">
      <div class="container">
        <CategoryList fadeUp />
        <div class="v-dyn-list">
          <div role="list" class="recipe-card-list v-dyn-items">
            {pageRecipes.map((recipe) => (
              <div role="listitem" class="fade-up v-dyn-item">
                <RecipeCard recipe={recipe} />
              </div>
            ))}
          </div>
          {hasNext && <Pagination nextHref="/recipes/2/" />}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
