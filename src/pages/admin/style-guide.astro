			</div>
			<div class="sg-block">
				<p class="sg-label">Heading XL</p>
				<h1 class="heading xl">This is a heading.</h1>
			</div>
			<div class="sg-block">
				<p class="sg-label">Heading L</p>
				<h2 class="heading l">This is a heading.</h2>
			</div>
			<div class="sg-block">
				<p class="sg-label">Heading M</p>
				<h3 class="heading m">This is a heading.</h3>
			</div>
			<div class="sg-block">
				<p class="sg-label">Heading S</p>
				<h4 class="heading s">This is a heading.</h4>
