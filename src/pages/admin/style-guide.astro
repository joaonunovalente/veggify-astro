---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
---

<BaseLayout title="Style guide" description="Veggify style guide.">
  <SiteHeader />
<div class="section white">
		<div class="container">
			<div class="text-box s">
				<h1>Style Guide</h1>
				<p>The style guide contains important styles and components that are used throughout the template.</p>
			</div>
		</div>
	</div>
	<div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease"
		role="banner" class="sg-navigation sticky v-nav">
		<div class="container">
			<nav role="navigation" class="sg-nav-menu v-nav-menu"><a href="style-guide.html#Typography"
					class="sg-nav-link v-nav-link">Typography</a><a href="style-guide.html#Colors"
					class="sg-nav-link v-nav-link">Colors</a><a href="style-guide.html#Buttons"
					class="sg-nav-link v-nav-link">Buttons</a><a href="style-guide.html#Columns"
					class="sg-nav-link v-nav-link">Columns</a><a href="style-guide.html#Grids"
					class="sg-nav-link v-nav-link">Grids</a><a href="style-guide.html#Spacers"
					class="sg-nav-link v-nav-link">Spacers</a><a href="style-guide.html#Forms"
					class="sg-nav-link v-nav-link">Forms</a></nav>
		</div>
	</div>
	<section id="Typography" class="section m">
		<div class="container">
			<div class="sg-intro-wrapper">
