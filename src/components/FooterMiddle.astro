---
/**
 * Middle of the footer: brand, description and social row on the left, the
 * public and admin link columns on the right. Both columns come from the
 * `footer` export in @/config/site, and the current page is marked with
 * aria-current.
 */

import SocialLinks from "@/components/SocialLinks.astro";
import { footer, siteConfig } from "@/config/site";
import { contact } from "@/config/contact";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isCurrent = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));

// Keep in sync with SiteHeader: no Contact link when the form is disabled.
const exploreLinks = footer.navigation.links.filter(
  (link) => contact.enabled || link.href !== "/contact/",
);
---

<div class="footer-middle">
  <div class="container">
    <div class="footer-middle-wrapper">
      <div class="footer-text-wrapper">
        <div class="footer-text-wrapper">
          <a
            href="/"
            aria-current={isHome ? "page" : undefined}
            class:list={["brand footer v-nav-brand", isHome && "v--current"]}
          >
            <span class="wordmark">{siteConfig.name}</span>
          </a>
          <p class="paragraph smalll">{siteConfig.description}</p>
        </div>
        <SocialLinks alignLeft />
      </div>
      <div class="footer-link-wrapper">
        <div class="footer-subhead">{footer.navigation.title}</div>
        <div class="footer-rule"></div>
        {exploreLinks.map(({ label, href }) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined} class="footer-link">
            {label}
          </a>
        ))}
      </div>
      <div class="footer-link-wrapper">
        <div class="footer-subhead">{footer.adminNavigation.title}</div>
        <div class="footer-rule"></div>
        <div class:list={[footer.adminNavigation.columns && "footer-link-columns"]}>
          {footer.adminNavigation.links.map(({ label, href }) => (
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined} class="footer-link">
              {label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
